{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [     
         {
            "name": "Launch Web App",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/DotnetNewWebapi/DotnetNewWebapi.csproj",
            "launchProfile": "DotnetNewWebapi", // Имя профиля из launchSettings.json
            "console": "integratedTerminal"
         },
         {
            "name": "Launch Web App (CoreCLR)",
            "type": "coreclr", // Меняем тип на классический дебаггер .NET
            "request": "launch",
            //"preLaunchTask": "build", // Убедитесь, что у вас есть таска build, либо удалите эту строку
            "program": "${workspaceFolder}/src/DotnetNewWebapi/bin/Debug/net10.0/DotnetNewWebapi.dll",                                    
            "args": [],
            "cwd": "${workspaceFolder}/src/DotnetNewWebapi",
            "console": "integratedTerminal", // Теперь этот параметр сработает отлично
            "env": {
               "ASPNETCORE_ENVIRONMENT": "Development"
            }
         },
         {
            "name": "Build CSharp_Tasks",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/CSharp_Tasks/CSharp_Tasks.csproj",
         }
    ]
}